:in20 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Coefficient de surcroît de ventilation lorsqu’un accident est actif ; il s’ajoute au coefficient de pollution dans le même facteur." ;
    skos:prefLabel "accident_sensitivity" ;
    schema:defaultValue "0.75" ;
    schema:description "Coefficient de surcroît de ventilation lorsqu’un accident est actif ; il s’ajoute au coefficient de pollution dans le même facteur." ;
    schema:name "accident_sensitivity" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "accident_sensitivity" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in21 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Date de début au format YYYY-MM-DD ; détermine le calendrier, les jours de semaine et les saisons du modèle." ;
    skos:prefLabel "start_date" ;
    schema:defaultValue "2025-01-01" ;
    schema:description "Date de début au format YYYY-MM-DD ; détermine le calendrier, les jours de semaine et les saisons du modèle." ;
    schema:name "start_date" ;
    schema:valueRequired true ;
