:in0 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Longueur du tunnel commune aux tubes ; convertie en kilomètres pour les charges proportionnelles à la longueur." ;
    skos:prefLabel "length_m" ;
    schema:defaultValue "1500" ;
    schema:description "Longueur du tunnel commune aux tubes ; convertie en kilomètres pour les charges proportionnelles à la longueur." ;
    schema:name "length_m" ;
    schema:unitCode unit:M ;
    schema:unitText "m" ;
    schema:valueRequired true ;
    wsem:apiVariable "length_m" ;
    wsem:canonicalUnit unit:M ;
    wsem:quantityKind qk:Length .

:in1 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Nombre de tubes ; multiplie les charges de ventilation et d’auxiliaires et contribue au nombre total de voies." ;
    skos:prefLabel "n_tubes" ;
    schema:defaultValue "2" ;
    schema:description "Nombre de tubes ; multiplie les charges de ventilation et d’auxiliaires et contribue au nombre total de voies." ;
    schema:name "n_tubes" ;
    schema:unitCode unit:NUM ;
    schema:unitText "count" ;
    schema:valueRequired true ;
    wsem:apiVariable "n_tubes" ;
    wsem:canonicalUnit unit:NUM ;
    wsem:quantityKind qk:Count .

:in10 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Puissance fixe ajoutée une seule fois à la demande totale du tunnel, avant le bruit multiplicatif global." ;
    skos:prefLabel "base_fixed_kw" ;
    schema:defaultValue "40.0" ;
    schema:description "Puissance fixe ajoutée une seule fois à la demande totale du tunnel, avant le bruit multiplicatif global." ;
    schema:name "base_fixed_kw" ;
    schema:unitCode unit:KiloW ;
    schema:unitText "kW" ;
    schema:valueRequired true ;
    wsem:apiVariable "base_fixed_kw" ;
    wsem:canonicalUnit unit:KiloW ;
    wsem:quantityKind qk:Power .

:in11 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Multiplicateur du profil synthétique de trafic normalisé ; l’indice final est borné entre 0 et 2 dans TLS." ;
    skos:prefLabel "traffic_level" ;
    schema:defaultValue "1.0" ;
    schema:description "Multiplicateur du profil synthétique de trafic normalisé ; l’indice final est borné entre 0 et 2 dans TLS." ;
    schema:name "traffic_level" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "traffic_level" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in12 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Heure du centre du pic gaussien du matin, comprise entre 0 inclus et 24 exclu." ;
    skos:prefLabel "morning_peak_hour" ;
    schema:defaultValue "8.0" ;
    schema:description "Heure du centre du pic gaussien du matin, comprise entre 0 inclus et 24 exclu." ;
    schema:name "morning_peak_hour" ;
    schema:unitCode unit:HR ;
    schema:unitText "h" ;
    schema:valueRequired true ;
    wsem:apiVariable "morning_peak_hour" ;
    wsem:canonicalUnit unit:HR ;
    wsem:quantityKind qk:Time .

:in13 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Heure du centre du pic gaussien du soir, comprise entre 0 inclus et 24 exclu." ;
    skos:prefLabel "evening_peak_hour" ;
    schema:defaultValue "18.0" ;
    schema:description "Heure du centre du pic gaussien du soir, comprise entre 0 inclus et 24 exclu." ;
    schema:name "evening_peak_hour" ;
    schema:unitCode unit:HR ;
    schema:unitText "h" ;
    schema:valueRequired true ;
    wsem:apiVariable "evening_peak_hour" ;
    wsem:canonicalUnit unit:HR ;
    wsem:quantityKind qk:Time .

:in14 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Écart-type temporel du pic gaussien du matin en heures ; TLS utilise 1,15 fois cette valeur pour le soir." ;
    skos:prefLabel "peak_width_h" ;
    schema:defaultValue "1.4" ;
    schema:description "Écart-type temporel du pic gaussien du matin en heures ; TLS utilise 1,15 fois cette valeur pour le soir." ;
    schema:name "peak_width_h" ;
    schema:unitCode unit:HR ;
    schema:unitText "h" ;
    schema:valueRequired true ;
    wsem:apiVariable "peak_width_h" ;
    wsem:canonicalUnit unit:HR ;
    wsem:quantityKind qk:Time .

:in15 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Coefficient du trafic dans la charge de ventilation : facteur 0,15 + traffic_sensitivity × traffic_index." ;
    skos:prefLabel "traffic_sensitivity" ;
    schema:defaultValue "0.65" ;
    schema:description "Coefficient du trafic dans la charge de ventilation : facteur 0,15 + traffic_sensitivity × traffic_index." ;
    schema:name "traffic_sensitivity" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "traffic_sensitivity" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in16 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Écart-type du bruit gaussien relatif appliqué à la puissance totale ; la puissance résultante est ramenée au minimum à zéro." ;
    skos:prefLabel "noise_sigma" ;
    schema:defaultValue "0.06" ;
    schema:description "Écart-type du bruit gaussien relatif appliqué à la puissance totale ; la puissance résultante est ramenée au minimum à zéro." ;
    schema:name "noise_sigma" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "noise_sigma" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in17 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Probabilité journalière de tirer un événement synthétique de pollution ; TLS tire ensuite son début et sa durée." ;
    skos:prefLabel "pollution_probability_per_day" ;
    schema:defaultValue "0.05" ;
    schema:description "Probabilité journalière de tirer un événement synthétique de pollution ; TLS tire ensuite son début et sa durée." ;
    schema:name "pollution_probability_per_day" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "pollution_probability_per_day" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in18 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Probabilité journalière de tirer un événement synthétique d’accident ; TLS tire ensuite son début et sa durée." ;
    skos:prefLabel "accident_probability_per_day" ;
    schema:defaultValue "0.015" ;
    schema:description "Probabilité journalière de tirer un événement synthétique d’accident ; TLS tire ensuite son début et sa durée." ;
    schema:name "accident_probability_per_day" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "accident_probability_per_day" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in19 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Coefficient de surcroît de ventilation lorsqu’un événement de pollution est actif : ajout à 1 + pollution_sensitivity × indicateur." ;
    skos:prefLabel "pollution_sensitivity" ;
    schema:defaultValue "0.55" ;
    schema:description "Coefficient de surcroît de ventilation lorsqu’un événement de pollution est actif : ajout à 1 + pollution_sensitivity × indicateur." ;
    schema:name "pollution_sensitivity" ;
    schema:unitCode unit:UNITLESS ;
    schema:unitText "1" ;
    schema:valueRequired true ;
    wsem:apiVariable "pollution_sensitivity" ;
    wsem:canonicalUnit unit:UNITLESS ;
    wsem:quantityKind qk:Dimensionless .

:in2 a schema:PropertyValueSpecification,
        wsem:ParameterDefinition ;
    skos:definition "Nombre de voies dans chaque tube ; l’éclairage est dimensionné sur n_tubes × n_lanes_per_tube." ;
    skos:prefLabel "n_lanes_per_tube" ;
    schema:defaultValue "2" ;
    schema:description "Nombre de voies dans chaque tube ; l’éclairage est dimensionné sur n_tubes × n_lanes_per_tube." ;
    schema:name "n_lanes_per_tube" ;
    schema:unitCode unit:NUM ;
    schema:unitText "count" ;
